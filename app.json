{
  "expo": {
    "name": "MeshVoice",
    "slug": "moto-voice-chat",
    "version": "1.0.0",
    "scheme": "my-app",
    "platforms": [
      "ios",
      "android"
    ],
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://expo.dev"
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "@config-plugins/react-native-webrtc",
      "./plugins/withDebugBundle.js",
      "./plugins/withNotifeeForegroundServiceType.js",
      "expo-audio",
      "expo-asset",
      "expo-font",
      "./withModularHeaders.js",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Геопозиция нужна, чтобы показывать вас на карте друзей и считать статистику заездов.",
          "locationAlwaysAndWhenInUsePermission": "Фоновая геопозиция нужна, чтобы трекинг заезда продолжался при выключенном экране.",
          "isAndroidBackgroundLocationEnabled": true
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "tsconfigPaths": true
    },
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#020617"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bitcode": false,
      "bundleIdentifier": "com.anonymous.myapp",
      "infoPlist": {
        "UIBackgroundModes": [
          "audio",
          "voip",
          "location"
        ],
        "NSMicrophoneUsageDescription": "Микрофон нужен для голосовой связи с другими участниками.",
        "NSLocalNetworkUsageDescription": "Доступ к локальной сети нужен для поиска участников рядом (mesh-режим COMM_CENTER).",
        "NSBonjourServices": [
          "_voicechat._tcp"
        ],
        "NSLocationWhenInUseUsageDescription": "Геопозиция нужна, чтобы показывать вас на карте друзей и считать статистику заездов.",
        "NSLocationAlwaysAndWhenInUseUsageDescription": "Фоновая геопозиция нужна, чтобы трекинг заезда продолжался при выключенном экране."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#020617"
      },
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_MICROPHONE",
        "android.permission.FOREGROUND_SERVICE_LOCATION",
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.WAKE_LOCK",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_BACKGROUND_LOCATION",
        "android.permission.BLUETOOTH_CONNECT",
        "android.permission.CHANGE_WIFI_MULTICAST_STATE",
        "android.permission.ACCESS_NETWORK_STATE",
        "android.permission.CAMERA",
        "android.permission.INTERNET",
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.BLUETOOTH"
      ],
      "package": "com.anonymous.myapp"
    },
    "extra": {
      "eas": {
        "projectId": "b4c8eba9-d9ff-4978-a983-2c262c956a31"
      }
    },
    "owner": "1mposs1bl3"
  }
}
